        "steps":{
            "1":["Gathering the materials", 6000],
            "2":["Preparing the iv site", 7000],
            "3":["Placing the needle", 10000],
            "4":["Securing the iv access", 11500],
            "5": ["Administering fluid throught IV line", 13000]
        }           
    },
    "centralAccess": {
        "description":"Start a central venous catheter (CVC)",
