        "steps":{
            "1":["Gathering the materials", 6000],
            "2":["Preparing the puncture site", 7000],
            "3":["Placing the needle", 10000],
            "4":["Securing the iv access", 13500],
            "5": ["Administering fluid throught CVC line", 15000]
        }           
    },
    "arterialAccess": {
        "description":"Start an arterial access",
        "onceTimeSteps": true,
        "steps":{
            "1":["Gathering the materials", 6000],
            "2":["Preparing the puncture site", 7000],
            "3":["Placing the needle", 10000],
            "4":["Securing the arterial access", 12500]
        }           
    },
    "osseousAccess": {
        "description":"Start an intraosseous (IO) access",
