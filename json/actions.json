{
    "callHelp": {
        "description": "Call for Help/ACLS team",
        "steps":{
            "1":["Calling for help...", 1000]
        }
    },
    "anamnesis": {"description":"Ask for patient medical history"},
    "patientCheck":{
        "description":"Check patient status (responsivness, breathing and pulse)",
        "steps":{
            "1":["Assessing patient responsivness", 1000],
            "2":["Checking airways and breathing", 3000],
            "3":["Checking pulse", 4000]
        }
    },
    "pulseCheck": {
        "description":"Check patient pulse",
        "steps":{
            "1":["Checking patient pulse", 2000]
        }
    },
		"bodyCheck": {
			"description":"Perform a trauma Body-Check",
			"steps":{
					"1":["Assessing CGS", 3000],
					"2":["Checking pupils reaction", 5000],
					"3":["Checking for neck pain", 6000],
					"4":["abdominal pain...", 8000],
					"5":["pelvic ring fracture...", 9000],
					"6":["bilateral lungs sound...", 12000],
					"7":["upper and down limbs mobility, sensitivity and perfusion...", 15000],
					"8":["spine/back pain...", 17000]
			}
		},
	  "immobilization": {
        "description":"Immobilize the patient",
        "steps":{
            "1":["Applying a cervical collar", 4000],
						"2":["Applying pelvic slings", 7000],
						"3":["Immobilize the patien within a vacuum mattress", 15000],
						"4":["Covering the patient with a warm blanket", 16000]
        }
    },
    "startCPR": {"description":"Start CPR 30:2 for 2 minutes"},
    "ecg": {
        "description": "Get patient ECG",
        "onceTimeSteps": true,
        "steps":{
            "1":["Placing the defibrillator paddles", 3000],
            "2":["Switching on the defibrillator monitor", 3500]
        }
    },
    "vitalParams": {
        "description":"Get patient vital parameters",
        "onceTimeSteps": true,
        "steps":{
            "1":["Applying the ECG electrodes", 3000],
            "3":["Measuring the Oxygen", 5100],
            "2":["Getting the blood pressure", 5000]
        }
    },
    "bloodPressure": {"description":"Get patient blood pressure"},
    "defibrillation": {
        "description":"Perform a defibrillation (200J, biphasic)",
        "steps":{
            "1":["Loading defibrillator to 200J", 2000],
            "2":["All clear!", 2500],
            "3":["Schock delivering!", 2600]
        }                
    },
    "cardioversion": {
        "description":"Deliver a synchronized shock (100J, biphasic)",
        "steps":{
            "1":["Setting defibrillator in sync mode", 500],
            "2":["Loading defibrillator to 100J", 2500],
            "3":["All clear!", 3000],
            "4":["Schock delivering!", 3100]
        }              
        },
    "venousAccess": {
        "description":"Start a periphere venous (IV) access",
