            "5":["Blocking the cuff/securing the tube", 11500]
        }
    },
    "co2Check": {
        "description":"Check CO2",
        "onceTimeSteps": true,
        "steps":{
            "1":["Getting out the CO2 sensor", 2000],
            "2":["Connecting the sensor to the tube", 3000]
        }
    },
    "lungsCheck": {
        "description":"Check for bilateral lungs sounds",
        "steps":{
            "1":["Getting the stethoscope", 1000],
            "2":["Cheking the left lung", 1500],
            "3":["Cheking the right lung", 2500]
        }  
    },
    "retrieveTube": {
        "description":"Retrieve the tube",
        "steps":{
            "1":["Unblocking the tube cuff", 600],
            "2":["Pulling the tube 2 cm back", 1200],
            "3":["Re-blocking the cuff", 1500]
        }  
    },
    "relievePnx": {
        "description":"Perform an emergency lung decompression",
        "steps":{
            "1":["Gathering the materials", 5000],
            "2":["Identifying the decompression site", 5500],
            "3":["Preparing the puncture site", 7000],
            "4":["Placing the needle (positive air aspiration)", 10000],
            "5":["Securing the needle", 11500]
        }
    },
    "airwayCheck": {
        "description":"Check the upper airways for food/blood",
        "steps":{
            "1":["Opening the patient mounth", 1000],
            "2":["Checking the upper airways for food/blood", 2000]
        }
    },
    "airwayFree": {
        "description":"Free the upper airways from food/blood/secretions",
        "steps":{
            "1":["Opening the patient mounth", 500],
            "2":["Inserting the laringoskope", 1000],
            "3":["Checking the upper airways for food/blood/vomit", 1500],
            "4":["Preparing removal tools (Magill's forceps/suction device)", 3000],
            "5":["Removing food/blood/vomit from the upper airways", 5000]
        }
    },
    "heimlichManeuver": {"description":"Give five abdominal thrusts"},
    "backBlows": {"description": "Give five back blows between the patient's shoulder blades"},
		"warming": {"description": "Cover the patient with a warm blanket and/or give warm fluids"}
